# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
# Used only when initializing an empty database. Minimum 8 characters.
TEMP_ADMIN_USERNAME=admin
TEMP_ADMIN_PASSWORD=
# Bind locally by default; put an HTTPS reverse proxy in front of the app.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
CORS_ORIGINS=http://localhost:8080
